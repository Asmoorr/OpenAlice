meta {
  name: 03 Question
  type: http
  seq: 2
}
post {
  url: {{base_url}}/alice/webhook/{{webhook_secret}}
  body: json
  auth: none
}
body:json {
  {
    "request": {
      "command": "Расскажи о себе",
      "original_utterance": "Расскажи о себе",
      "type": "SimpleUtterance"
    },
    "session": {
      "message_id": 2,
      "session_id": "{{run_id}}-smoke",
      "skill_id": "bruno-skill",
      "new": false,
      "application": {
        "application_id": "bruno-app"
      },
      "user": {
        "user_id": "{{user_id}}-smoke-{{run_id}}"
      }
    },
    "version": "1.0"
  }
}
tests {
  test("Alice response contract", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.version).to.equal("1.0");
    expect(body.response.text).to.be.a("string").and.not.empty;
    expect(body.response.tts).to.equal(body.response.text);
    expect(body.response.end_session).to.equal(false);
    expect(body.response.text).to.contain(bru.getEnvVar("fake_answer"));
  });
}
