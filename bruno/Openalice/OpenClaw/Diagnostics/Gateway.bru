meta {
  name: Local Gateway diagnostics
  type: http
  seq: 1
}

post {
  url: http://127.0.0.1:18789/v1/responses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.OPENCLAW_GATEWAY_TOKEN}}
}

body:json {
  {
    "model": "openclaw/default",
    "input": "Расскажи о себе",
    "user": "random_123123",
    "instructions": "Отвечай по-русски, пригодным для озвучивания текстом без Markdown. Сначала дай краткий полезный ответ, желательно до 800 символов."
  }
}

script:pre-request {
  if (!bru.getProcessEnv("OPENCLAW_GATEWAY_TOKEN")) {
    throw new Error("Задайте OPENCLAW_GATEWAY_TOKEN в локальном .env");
  }
}

tests {
  test("Gateway contract", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.output_text || body.output).to.exist;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
